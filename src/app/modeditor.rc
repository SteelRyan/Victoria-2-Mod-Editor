// The exe's version block: Explorer → ModEditor.exe → Properties → Details shows it.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MODEDITOR_VERSION_MAJOR, MODEDITOR_VERSION_MINOR, MODEDITOR_VERSION_PATCH, 0
 PRODUCTVERSION MODEDITOR_VERSION_MAJOR, MODEDITOR_VERSION_MINOR, MODEDITOR_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ModEditor - a mod editor for Victoria II"
            VALUE "FileVersion", MODEDITOR_VERSION_TEXT
            VALUE "InternalName", "ModEditor"
            VALUE "OriginalFilename", "ModEditor.exe"
            VALUE "ProductName", "ModEditor"
            VALUE "ProductVersion", MODEDITOR_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
